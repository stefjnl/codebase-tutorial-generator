{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning",
            "DotNetTutorialGenerator": "Debug"
        }
    },
    "Serilog": {
        "MinimumLevel": "Debug"
    },
    "LLMSettings": {
