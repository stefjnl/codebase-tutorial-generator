@page "/generate"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.SignalR.Client
@using DotNetTutorialGenerator.Blazor.Components
@using DotNetTutorialGenerator.Blazor.Services
@using DotNetTutorialGenerator.Core.Interfaces
@inject IAppState AppState
@inject ITutorialGenerationService TutorialGenerationService
@inject NavigationManager NavigationManager

<PageTitle>Generate Tutorial</PageTitle>

<div class="generate-header">
    <h1>Generate Tutorial</h1>
    <p class="lead">Transform a .NET codebase into a comprehensive tutorial with AI-powered analysis</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3><i class="bi bi-folder2-open text-primary"></i> Source Selection</h3>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs" id="sourceTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="github-tab" data-bs-toggle="tab" data-bs-target="#github"
                            type="button" role="tab">
                            <i class="bi bi-github"></i> GitHub Repository
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="local-tab" data-bs-toggle="tab" data-bs-target="#local"
                            type="button" role="tab">
                            <i class="bi bi-folder"></i> Local Files
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="sourceTabsContent">
                    <div class="tab-pane fade show active" id="github" role="tabpanel">
                        <div class="mb-3">
                            <label for="githubUrl" class="form-label">GitHub Repository URL</label>
                            <input type="text" class="form-control" id="githubUrl"
                                placeholder="https://github.com/user/repo" @bind="githubUrl">
                            <div class="form-text">Enter the full URL to a public GitHub repository containing a .NET
                                project.</div>
                        </div>
                        <button class="btn btn-primary" @onclick="ValidateGitHubUrl">
                            <i class="bi bi-check-circle"></i> Validate Repository
                        </button>
                    </div>
                    <div class="tab-pane fade" id="local" role="tabpanel">
                        <FileDropZone OnFilesSelected="HandleFilesSelected" />
                        <div class="form-text mt-2">Upload a .zip file containing your .NET project files.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h3><i class="bi bi-gear text-secondary"></i> Generation Configuration</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="language" class="form-label">Language</label>
                            <select class="form-select" id="language" @bind="selectedLanguage">
                                <option value="English">English</option>
                                <option value="Spanish">Spanish</option>
                                <option value="French">French</option>
                                <option value="German">German</option>
                                <option value="Chinese">Chinese</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="maxAbstractions" class="form-label">Max Abstractions: @maxAbstractions</label>
                            <input type="range" class="form-range" id="maxAbstractions" min="5" max="25"
                                @bind="maxAbstractions">
                        </div>
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="generateDiagrams" @bind="generateDiagrams">
                    <label class="form-check-label" for="generateDiagrams">
                        <i class="bi bi-diagram-3"></i> Generate Architecture Diagrams
                    </label>
                </div>
                <div class="d-grid">
                    <button class="btn btn-success btn-lg" @onclick="GenerateTutorial"
                        disabled="@(!isSourceValid || isGenerating)">
                        @if (isGenerating)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <i class="bi bi-play-circle-fill"></i>
                            <span>Generate Tutorial</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card sticky-top">
            <div class="card-header">
                <h3><i class="bi bi-speedometer2 text-info"></i> Progress</h3>
            </div>
            <div class="card-body">
                @if (isGenerating)
                {
                    <ProgressIndicator Progress="@currentProgress" CurrentPhase="@currentPhase" />
                    <LogStreamViewer Logs="@logMessages" />
                    <div class="d-grid gap-2 mt-3">
                        <button class="btn btn-outline-danger" @onclick="CancelGeneration">
                            <i class="bi bi-x-circle"></i> Cancel Generation
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-play-circle" style="font-size: 3rem; color: #ccc;"></i>
                        <p class="mt-3">Configure your tutorial generation settings and click "Generate Tutorial" to begin.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string githubUrl = "";
    private bool isSourceValid = false;
    private string selectedLanguage = "English";
    private int maxAbstractions = 15;
    private bool generateDiagrams = true;
    private bool isGenerating = false;
    private int currentProgress = 0;
    private string currentPhase = "";
    private List<string> logMessages = new List<string>();
    private int currentTutorialId = 0;

    private async Task ValidateGitHubUrl()
    {
        if (!string.IsNullOrEmpty(githubUrl))
        {
            // In a real implementation, this would validate the GitHub URL
            isSourceValid = true;
            AppState.SetNotification("GitHub URL validated successfully", NotificationType.Success);
        }
    }

    private void HandleFilesSelected(IEnumerable<string> files)
    {
        // In a real implementation, this would handle the selected files
        isSourceValid = files.Any();
        AppState.SetNotification($"Selected {files.Count()} files for processing", NotificationType.Success);
    }

    private async Task GenerateTutorial()
    {
        isGenerating = true;
        currentProgress = 0;
        logMessages.Clear();

        // Connect to the SignalR hub for real-time progress updates
        var connection = new HubConnectionBuilder()
        .WithUrl($"{NavigationManager.BaseUri}tutorialprogress")
        .Build();

        connection.On<GenerationProgress>("ReceiveProgressUpdate", (progress) =>
        {
            currentProgress = progress.Percentage;
            currentPhase = progress.CurrentPhase;
            StateHasChanged();
        });

        connection.On<string>("ReceiveLogMessage", (message) =>
        {
            logMessages.Add(message);
            StateHasChanged();
        });

        connection.On<string>("ReceiveError", (error) =>
        {
            AppState.SetNotification($"Error during generation: {error}", NotificationType.Error);
            isGenerating = false;
            StateHasChanged();
        });

        connection.On<string>("ReceiveCompletion", (path) =>
        {
            AppState.SetNotification("Tutorial generation completed successfully", NotificationType.Success);
            isGenerating = false;
            StateHasChanged();
        });

        try
        {
            await connection.StartAsync();

            // Create generation options
            var options = new TutorialGenerationOptions
            {
                Language = selectedLanguage,
                MaxAbstractions = maxAbstractions,
                GenerateDiagrams = generateDiagrams
            };

            // Start the tutorial generation process
            currentTutorialId = await TutorialGenerationService.StartGenerationAsync(githubUrl, options);

            // Join the tutorial group for progress updates
            await connection.InvokeAsync("JoinTutorialGroup", currentTutorialId);
        }
        catch (Exception ex)
        {
            AppState.SetNotification($"Error during generation: {ex.Message}", NotificationType.Error);
            isGenerating = false;
        }
    }

    private async Task CancelGeneration()
    {
        // In a real implementation, this would cancel the generation process
        isGenerating = false;
        AppState.SetNotification("Tutorial generation cancelled", NotificationType.Info);
    }
}
