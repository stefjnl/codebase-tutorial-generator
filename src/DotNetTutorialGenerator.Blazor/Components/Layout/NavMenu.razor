@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing

<div class="sidebar-content">
    <div class="sidebar-header">
        <h2>.NET Tutorial Generator</h2>
        <p>Transform codebases into tutorials</p>
    </div>

    <nav class="sidebar-nav">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door-fill nav-icon"></i>
            <span class="nav-text">Dashboard</span>
        </NavLink>
        <NavLink class="nav-item" href="generate">
            <i class="bi bi-play-circle-fill nav-icon"></i>
            <span class="nav-text">Generate</span>
        </NavLink>
        <NavLink class="nav-item" href="history">
            <i class="bi bi-clock-history nav-icon"></i>
            <span class="nav-text">History</span>
        </NavLink>
        <NavLink class="nav-item" href="settings">
            <i class="bi bi-gear-fill nav-icon"></i>
            <span class="nav-text">Settings</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <p>Version 1.0.0</p>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
