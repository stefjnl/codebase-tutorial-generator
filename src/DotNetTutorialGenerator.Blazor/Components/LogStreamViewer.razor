@using DotNetTutorialGenerator.Blazor.Services
@using Microsoft.JSInterop
@inject IAppState AppState
<div class="log-stream-viewer">
    <div class="log-header">
        <h5>Generation Log</h5>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLogs">
            <i class="bi bi-trash"></i> Clear
        </button>
    </div>
    <div class="log-container" @ref="logContainer">
        @if (Logs != null && Logs.Any())
        {
            @foreach (var log in Logs)
            {
                <div class="log-entry">
                    <span class="log-timestamp">[@DateTime.Now.ToString("HH:mm:ss")]</span>
                    <span class="log-message">@log</span>
                </div>
            }
        }
        else
        {
            <div class="log-empty">
                <p>No log messages yet. Generation will start shortly...</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<string>? Logs { get; set; }

    private ElementReference logContainer;

    private void ClearLogs()
    {
        // In a real implementation, this would clear the logs
        AppState.SetNotification("Logs cleared", NotificationType.Info);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Logs != null && Logs.Any())
        {
            // Scroll to bottom of log container
            await logContainer.FocusAsync();
        }
    }
}
